[{"name":"Delhi Tours Guide","city":"delhi-tours-guide","description":"Discover Delhi’s historic neighbourhoods, monuments and markets with a local guide.","image":"/assets/img/home-1/tour/delhi-tours-guide.webp","imageAlt":"","showOnMainGrid":true,"services":[{"name":"Delhi Sightseeing Tour With Tour Guide","slug":"delhi-sightseeing-tour-with-tour-guide","summary":"Discover the culture, history, monuments, and bustling markets of Old and New Delhi on a private sightseeing tour with a professional guide.","description":"Discover the highlights of the heart of India on this private Delhi Sightseeing Tour With Tour Guide. Learn about and admire the culture and history of Old and New Delhi. Benefit from the services of an expert tour guide to feel like a local on the city's most bustling streets. Travel in a comfortable private air-conditioned car. Guide services are available in English, Spanish, German, Italian, and French.","location":"Old & New Delhi","duration":"7–8 hours","groupSize":"Private tour","image":null,"imageAlt":"India Gate in New Delhi at sunset","gallery":[{"src":"assets/img/tours/old-delhi/jama-masjid.webp","alt":"Red sandstone facade of Jama Masjid in Old Delhi"},{"src":"assets/img/tours/old-delhi/chandni-chowk.webp","alt":"Colourful market street in Chandni Chowk, Old Delhi"}],"highlights":["Explore Delhi's UNESCO World Heritage Sites.","Swing by the Presidential House and Parliament.","Enjoy insights into the sites from a private tour guide.","Explore both sections of India's capital, New and Old Delhi.","Admire the 17th-century Jama Masjid.","Immerse yourself in local culture at the Sikh temple Gurudwara Bangla Sahib.","Enjoy a rickshaw ride through the vibrant streets of Chandni Chowk market."],"itinerary":[{"label":"Stop 1","title":"Pickup and Welcome","description":"Your tour guide and chauffeur will meet and greet you at 9 am or your preferred time at your given location. Begin exploring India's capital in a comfortable private air-conditioned car."},{"label":"Stop 2","title":"Jama Masjid","description":"Explore Jama Masjid, built at the height of Mughal power, and learn about the history and architecture of Old Delhi."},{"label":"Stop 3","title":"Chandni Chowk Rickshaw Ride","description":"Explore Old Delhi's colourful bazaars on a rickshaw ride through the bustling streets of Chandni Chowk."},{"label":"Stop 4","title":"Red Fort Photo Stop","description":"Stop for photographs at Red Fort."},{"label":"Stop 5","title":"Raj Ghat","description":"Visit Raj Ghat and pay homage to Mahatma Gandhi, the father of the Indian nation."},{"label":"Stop 6","title":"India Gate, Presidential Residence and Parliament House","description":"Drive around New Delhi for photographs at India Gate, the Presidential Residence (Rashtrapati Bhavan), and Parliament House."},{"label":"Stop 7","title":"Gurudwara Bangla Sahib","description":"Visit Gurudwara Bangla Sahib, a Sikh temple known for its community kitchen, and immerse yourself in local culture."},{"label":"Stop 8","title":"Agrasen ki Baoli","description":"Explore Agrasen ki Baoli, an old and beautiful stepwell in Delhi."},{"label":"Stop 9","title":"Qutub Minar","description":"Admire Qutub Minar, the historic brick victory tower whose construction began in the 12th century."},{"label":"Stop 10","title":"Return Transfer","description":"After your sightseeing tour, your chauffeur will drive you back to your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Delhi Sightseeing Tour With Tour Guide?","answer":"The tour lasts approximately 7–8 hours and covers Old and New Delhi."},{"question":"Where and when does the tour start?","answer":"Your tour guide and chauffeur will meet you at your given location at 9 am or your preferred time. You will be driven back to your given location after the tour."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Is transportation included?","answer":"Yes. The tour includes a private air-conditioned car, an experienced licensed driver, parking, toll taxes, fuel, and driver allowance."},{"question":"Are meals included?","answer":"Lunch and dinner are excluded. Packaged drinking water bottles are provided in the car."}],"mapEmbedUrl":"https://www.google.com/maps?q=Delhi+India&output=embed","seo":{"title":"Delhi Sightseeing Tour With Tour Guide | Old & New Delhi","description":"Explore Old and New Delhi on a private 7–8 hour sightseeing tour with a professional guide, AC car, Chandni Chowk rickshaw ride, and historic landmarks."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"Delhi Temple Tour With Tour Guide","slug":"delhi-temple-tour-with-tour-guide","summary":"Explore the temples of Old and New Delhi on a private guided tour and discover India's diverse religious traditions.","description":"Join an enthralling journey exploring Delhi's incredible temples with a professional tour guide. Visit Lotus Temple, Akshardham Temple, Digambar Lal Jain Temple, and Gurudwara Bangla Sahib to learn about India's diverse religious traditions, architecture, and spirituality. Travel in a comfortable private air-conditioned car. Guide services are available in English, Spanish, German, Italian, and French.","location":"Old & New Delhi Temples","duration":"6–7 hours","groupSize":"Private tour","image":null,"imageAlt":"Lotus Temple, a Baháʼí House of Worship in New Delhi","gallery":[],"highlights":["Enjoy comfortable transfers in a private air-conditioned car.","Discover the sites with insights from a private professional tour guide.","Admire Lotus Temple, a Baháʼí House of Worship.","Visit some of Delhi's most remarkable temples with a tour guide.","Learn about the spirituality and traditions of Hinduism, Sikhism, Jainism, and the Baháʼí Faith."],"itinerary":[{"label":"Stop 1","title":"Pickup and Welcome","description":"Your tour guide and chauffeur will meet and greet you at 9 am or your preferred time at your given location. Begin exploring Delhi's temples in a comfortable private air-conditioned car."},{"label":"Stop 2","title":"Digambar Lal Jain Temple","description":"Visit Digambar Lal Jain Temple and learn about Jainism, its spiritual traditions, and the goal of liberation from the cycle of rebirth. Hear stories from your guide about this historic temple, also known for its Jain Birds Hospital."},{"label":"Stop 3","title":"Akshardham Temple","description":"Explore this Hindu spiritual complex and admire its intricate architecture. Your guide will introduce you to the Indian traditions, architectural heritage, and spiritual messages reflected throughout the complex."},{"label":"Stop 4","title":"Gurudwara Bangla Sahib","description":"Visit this prominent Sikh shrine dedicated to the memory of Guru Har Krishan, the eighth Sikh Guru. Learn about its prayer hall, sacred pool, museum, library, and community kitchen."},{"label":"Stop 5","title":"Lotus Temple","description":"Admire Lotus Temple and learn about the Baháʼí Faith, which teaches the unity of all people and the essential worth of all religions. This House of Worship welcomes everyone regardless of nationality, religion, race, or gender."},{"label":"Stop 6","title":"Return Transfer","description":"After your Delhi Temple Tour With Tour Guide, your chauffeur will drive you back to your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Monument entrance fees and camera fees","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Delhi Temple Tour With Tour Guide?","answer":"The tour lasts approximately 6–7 hours and covers temples in Old and New Delhi."},{"question":"Which temples are included in the tour?","answer":"The tour visits Digambar Lal Jain Temple, Akshardham Temple, Gurudwara Bangla Sahib, and Lotus Temple."},{"question":"Where and when does the tour start?","answer":"Your tour guide and chauffeur will meet you at your given location at 9 am or your preferred time. You will be driven back to your given location after the tour."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Is transportation included?","answer":"Yes. The tour includes a private air-conditioned car, an experienced licensed driver, parking, toll taxes, fuel, and driver allowance."},{"question":"Are meals and entrance fees included?","answer":"Lunch, dinner, monument entrance fees, camera fees, and optional trips are excluded. Packaged drinking water bottles are provided in the car."}],"mapEmbedUrl":"https://www.google.com/maps?q=Delhi+India&output=embed","seo":{"title":"Delhi Temple Tour With Tour Guide | Old & New Delhi","description":"Explore Lotus Temple, Akshardham, Digambar Lal Jain Temple, and Bangla Sahib on a private 6–7 hour Delhi temple tour with a guide and AC car."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"Delhi Food Tour With Tour Guide","slug":"delhi-food-tour-with-tour-guide","summary":"Discover Delhi's street food, colourful markets, and local culture on a private guided tour with food tastings and a Chandni Chowk rickshaw ride.","description":"Experience local Indian food through the vibrant streets of Old Delhi on this Delhi Food Tour With Tour Guide. Visit hand-picked street vendors to taste local specialties, enjoy a rickshaw ride, and learn about the culture and history of Old and New Delhi. Explore with an expert tour guide and travel in a comfortable private air-conditioned car. Guide services are available in English, Spanish, German, Italian, and French.","location":"Old & New Delhi","duration":"4–6 hours","groupSize":"Private tour","image":null,"imageAlt":"Traditional Indian street food served in Old Delhi","gallery":[],"highlights":["Explore Old Delhi's colourful streets.","Swing by the Presidential House and Parliament.","Enjoy insights into the sites from a private professional tour guide.","Explore both sections of India's capital, New and Old Delhi.","Stop for photographs at the 17th-century Jama Masjid.","Visit hand-picked street vendors to taste local specialties.","Immerse yourself in local culture at Gurudwara Bangla Sahib.","Enjoy a rickshaw ride through the vibrant streets of Chandni Chowk market."],"itinerary":[{"label":"Stop 1","title":"Pickup and Welcome","description":"Your tour guide and chauffeur will meet and greet you at 9 am or your preferred time at your given location. Begin exploring India's capital in a comfortable private air-conditioned car and learn about its rich variety of cuisine."},{"label":"Stop 2","title":"Old Delhi Street Food and Aloo Poori","description":"Explore the vibrant streets of Old Delhi and visit selected food vendors. Taste Aloo Poori, a local specialty featuring fried wheat bread served with potatoes prepared with Indian spices."},{"label":"Stop 3","title":"Matar Kulcha","description":"Try Matar Kulcha, a popular Delhi street food made with dried white peas and served with a soft white flatbread called kulcha."},{"label":"Stop 4","title":"Stuffed Parathas","description":"Enjoy Indian stuffed flatbreads and learn about fillings such as spiced mashed potatoes, dal, cauliflower, mixed vegetables, radish, and paneer."},{"label":"Stop 5","title":"Refreshing Lassi","description":"After the savoury food, enjoy lassi, a yoghurt-based drink blended with water and sugar or spices. Sweet and salty varieties are available."},{"label":"Stop 6","title":"Return Transfer","description":"After your Delhi Food Tour With Tour Guide, your chauffeur will drive you back to your given location."}],"inclusions":["Rickshaw ride","Street food tasting","Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Monument entrance fees and camera fees","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Delhi Food Tour With Tour Guide?","answer":"The tour lasts approximately 4–6 hours and covers Old and New Delhi, with street food tastings in Old Delhi."},{"question":"Which foods will I try?","answer":"The itinerary includes Aloo Poori, Matar Kulcha, stuffed parathas, and lassi."},{"question":"Where and when does the tour start?","answer":"Your tour guide and chauffeur will meet you at your given location at 9 am or your preferred time. You will be driven back to your given location after the tour."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Are food tastings and the rickshaw ride included?","answer":"Yes. Street food tastings and a rickshaw ride are included. Lunch, dinner, and optional trips are excluded."},{"question":"Is transportation included?","answer":"Yes. The tour includes a private air-conditioned car, an experienced licensed driver, parking, toll taxes, fuel, and driver allowance. Packaged drinking water bottles are provided in the car."},{"question":"Are monument entrance fees included?","answer":"Monument entrance fees and camera fees are excluded."}],"mapEmbedUrl":"https://www.google.com/maps?q=Delhi+India&output=embed","seo":{"title":"Delhi Food Tour With Tour Guide | Old & New Delhi","description":"Taste Old Delhi's street food on a private 4–6 hour tour with a professional guide, food tastings, a Chandni Chowk rickshaw ride, and AC car transfers."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"Delhi Shopping Tour With Tour Guide","slug":"delhi-shopping-tour-with-tour-guide","summary":"Explore the markets of Old and New Delhi with a private shopping guide, from Chandni Chowk's bustling lanes to Khan Market and Indian handicraft bazaars.","description":"Discover Delhi's shopping scene on a private Delhi Shopping Tour With Tour Guide, including hotel transfers in an air-conditioned car. Explore Chandni Chowk's wholesale market, browse the boutiques of Khan Market, and search for Indian handicrafts at Dilli Haat or Village Arts and Crafts Bazaar. Your expert guide will share stories about the markets and help you experience shopping like a local. The tour can be customised to your preferences, interests, and budget, with walking, tuk-tuk, or luxury car options and durations ranging from half a day to two days. The standard tour lasts 7–8 hours. Guide services are available in English, Spanish, German, Italian, and French.","location":"Old & New Delhi","duration":"7–8 hours","groupSize":"Private tour","image":null,"imageAlt":"Colourful shops and bustling market lanes in Chandni Chowk, Old Delhi","gallery":[],"highlights":["Visit some of Delhi's most famous markets.","Refresh yourself with bottled drinking water provided in the car.","Enjoy a shopping experience that lets you explore like a local.","Benefit from a private expert shopping guide.","Enjoy a rickshaw ride through the vibrant streets of Chandni Chowk market.","Customise the tour to suit your preferences, interests, and budget."],"itinerary":[{"label":"Stop 1","title":"Pickup and Welcome","description":"Your tour guide and chauffeur will meet and greet you at 9 am or your preferred time at your given location. Begin exploring Delhi's markets in a comfortable private air-conditioned car."},{"label":"Stop 2","title":"Chandni Chowk","description":"Explore one of Old Delhi's oldest and busiest markets, known for its narrow lanes, wholesale shops, and lively streets. Hear stories about its Mughal origins and its design by Princess Jahanara Begum. Browse the shops and enjoy a rickshaw ride through the colourful market."},{"label":"Stop 3","title":"Khan Market","description":"Discover Khan Market, known for its fashion boutiques, bookstores, opticians, homeware shops, and cafés. Explore its shopping options with your private guide."},{"label":"Stop 4","title":"Dilli Haat or Village Arts and Crafts Bazaar","description":"Browse arts and handicrafts from across India at Dilli Haat or Village Arts and Crafts Bazaar. Explore the stalls and look for items that match your interests and shopping preferences."},{"label":"Stop 5","title":"Return Transfer","description":"After your Delhi Shopping Tour With Tour Guide, your chauffeur will drive you back to your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Delhi Shopping Tour With Tour Guide?","answer":"The standard tour lasts approximately 7–8 hours. Customised options are also available for half-day, full-day, and two-day tours."},{"question":"Which markets will I visit?","answer":"The itinerary covers Chandni Chowk, Khan Market, and Dilli Haat or Village Arts and Crafts Bazaar. The tour can be customised to suit your shopping interests."},{"question":"Can I customise the shopping tour?","answer":"Yes. The tour can be tailored to your preferences, interests, and budget. Walking, tuk-tuk, and luxury car options are available, along with different tour durations."},{"question":"Where and when does the tour start?","answer":"Your tour guide and chauffeur will meet you at your given location at 9 am or your preferred time. You will be driven back to your given location after the tour."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Is transportation included?","answer":"The standard tour includes a private air-conditioned car, an experienced licensed driver, parking, toll taxes, fuel, and driver allowance."},{"question":"Are meals included?","answer":"Lunch and dinner are excluded. Packaged drinking water bottles are provided in the car."}],"mapEmbedUrl":"https://www.google.com/maps?q=Delhi+India&output=embed","seo":{"title":"Delhi Shopping Tour With Tour Guide | Old & New Delhi","description":"Explore Chandni Chowk, Khan Market, and Indian handicraft bazaars on a private 7–8 hour Delhi shopping tour with an expert guide and AC car transfers."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"}],"breadcrumbImage":""},{"name":"Agra Tours Guide","city":"agra-tours-guide","description":"Explore the Taj Mahal, Agra Fort and Agra’s Mughal heritage with a local guide.","image":"/assets/img/home-1/tour/agra-tours-guide.webp","imageAlt":"","showOnMainGrid":true,"services":[{"name":"Private Taj Mahal Tour With Tour Guide From Delhi","slug":"private-taj-mahal-tour-with-tour-guide-from-delhi","summary":"Discover the Taj Mahal and Agra Fort on a private same-day trip from Delhi with a professional tour guide and round-trip transfers by air-conditioned car.","description":"Travel from Delhi to Agra and back on this Private Taj Mahal Tour With Tour Guide From Delhi. Meet your certified tour guide upon arrival in Agra and discover the history and architecture of the Taj Mahal and Agra Fort, both UNESCO World Heritage Sites.\n\nAdmire the white marble mausoleum built by Shah Jahan and explore the remarkable red sandstone fortress associated with the Mughal emperors.\n\nEnjoy comfortable round-trip travel in a private air-conditioned car with a professional chauffeur. Guide services are available in English, Spanish, German, Italian, and French.","location":"Delhi – Agra – Delhi","duration":"12–14 hours","groupSize":"Private tour","image":null,"imageAlt":"The Taj Mahal and its reflecting pool in Agra","gallery":[],"highlights":["Explore the UNESCO World Heritage Sites of the Taj Mahal and Agra Fort.","Learn about the monuments with insights from a private professional tour guide.","Travel to and from Delhi in a private air-conditioned car.","Visit the majestic Taj Mahal and admire its white marble architecture.","Explore the imposing red sandstone buildings of Agra Fort."],"itinerary":[{"label":"Stop 1","title":"Pickup in Delhi and Drive to Agra","description":"Your chauffeur will meet you at your given location between 6 am and 9 am, or at your preferred time.\n\nTravel to Agra via the expressway and relax during the approximately 3–4 hour journey in a comfortable private air-conditioned car."},{"label":"Stop 2","title":"Meet Your Guide and Visit the Taj Mahal","description":"Upon arrival in Agra, meet your professional tour guide and proceed to the Taj Mahal for an approximately 2–3 hour visit.\n\nLearn about Shah Jahan and Mumtaz Mahal as you admire the white marble mausoleum beside the Yamuna River. Explore its exterior and interior, including its intricate carvings and decorative stonework."},{"label":"Stop 3","title":"Optional Lunch Break","description":"After exploring the Taj Mahal, you can stop for a lunch break before continuing to Agra Fort. Lunch is at your own expense."},{"label":"Stop 4","title":"Agra Fort","description":"Explore Agra Fort with your tour guide and learn about its role as a residence of the Mughal emperors before the capital moved to Delhi.\n\nAdmire its red sandstone architecture, imposing walls, gateways, and riverside setting."},{"label":"Stop 5","title":"Return to Delhi and Drop-off","description":"After your guided visits, travel back to Delhi in your private air-conditioned car. Your chauffeur will drop you at your hotel, the airport, or your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide in Agra","Airport or hotel pickup and drop-off","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Monument entrance fees and camera fees","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Private Taj Mahal Tour With Tour Guide From Delhi?","answer":"The tour lasts approximately 12–14 hours, including round-trip travel between Delhi and Agra and guided visits to the Taj Mahal and Agra Fort."},{"question":"Where and when does the tour start?","answer":"Your chauffeur will collect you from your given location in Delhi between 6 am and 9 am, or at your preferred time."},{"question":"Where will I meet my tour guide?","answer":"You will meet your professional tour guide upon arrival in Agra before visiting the Taj Mahal."},{"question":"Which monuments are included in the itinerary?","answer":"The itinerary covers the Taj Mahal and Agra Fort, both UNESCO World Heritage Sites."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Is pickup and drop-off included?","answer":"Yes. Airport or hotel pickup and drop-off are included. At the end of the tour, your chauffeur will drop you at your hotel, the airport, or your given location in Delhi."},{"question":"Are meals and monument entrance fees included?","answer":"Lunch, dinner, monument entrance fees, camera fees, and optional trips are excluded. Packaged drinking water bottles are provided in the car."}],"mapEmbedUrl":"https://www.google.com/maps?q=Taj+Mahal+Agra+India&output=embed","seo":{"title":"Private Taj Mahal Tour With Tour Guide From Delhi","description":"Visit the Taj Mahal and Agra Fort on a private 12–14 hour tour from Delhi with a professional guide, AC car, and hotel or airport pickup and drop-off."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"Taj Mahal Sunrise Tour With Tour Guide From Delhi","slug":"taj-mahal-sunrise-tour-with-tour-guide-from-delhi","summary":"Experience sunrise at the Taj Mahal and explore Agra Fort on a private tour from Delhi with a professional guide and round-trip transfers by air-conditioned car.","description":"Discover the highlights of Agra on this Taj Mahal Sunrise Tour With Tour Guide From Delhi. Set off early to enjoy sunrise views of the Taj Mahal and explore its remarkable architecture with a private professional guide.\n\nLearn about the history of the Taj Mahal and Agra Fort, two UNESCO World Heritage Sites that showcase the city's Mughal heritage.\n\nEnjoy comfortable round-trip travel in a private air-conditioned car with a professional chauffeur and hotel or airport pickup and drop-off. Guide services are available in English, Spanish, German, Italian, and French.","location":"Delhi – Agra – Delhi","duration":"12–14 hours","groupSize":"Private tour","image":null,"imageAlt":"The Taj Mahal in Agra illuminated by the soft light of sunrise","gallery":[],"highlights":["Explore the UNESCO World Heritage Sites of the Taj Mahal and Agra Fort.","Learn about the monuments with insights from a private professional tour guide.","Travel to and from Delhi in a private air-conditioned car.","Experience the Taj Mahal at sunrise.","Admire the imposing red sandstone architecture of Agra Fort.","Enjoy arranged transfers for your early-morning journey to Agra."],"itinerary":[{"label":"Stop 1","title":"Early-Morning Pickup and Drive to Agra","description":"Your chauffeur will meet you at your given location in Delhi between 2 am and 3 am, or at your preferred time.\n\nTravel to Agra via the expressway and relax during the approximately 3–4 hour journey in a comfortable private air-conditioned car."},{"label":"Stop 2","title":"Meet Your Guide and Explore the Taj Mahal at Sunrise","description":"Upon arrival in Agra, meet your professional tour guide and proceed to the Taj Mahal for an approximately 2–3 hour visit. Enjoy sunrise views of this iconic white marble mausoleum beside the Yamuna River.\n\nLearn about Shah Jahan and Mumtaz Mahal as you explore the monument's exterior and interior. Admire its intricate carvings, decorative stonework, and Mughal architecture."},{"label":"Stop 3","title":"Optional Breakfast Break","description":"After exploring the Taj Mahal, you can stop for a breakfast break before continuing to Agra Fort. Breakfast is not listed among the tour inclusions."},{"label":"Stop 4","title":"Agra Fort","description":"Explore Agra Fort with your tour guide and learn about its association with Emperor Akbar and its role as a residence of the Mughal emperors before the capital moved to Delhi.\n\nAdmire the fortress's red sandstone architecture, imposing ramparts, gateways, and riverside setting."},{"label":"Stop 5","title":"Return to Delhi and Drop-off","description":"After your guided visits, travel back to Delhi in your private air-conditioned car. Your chauffeur will drop you at your hotel, the airport, or your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide in Agra","Airport or hotel pickup and drop-off","Packaged drinking water bottles in the car","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Monument entrance fees and camera fees","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Taj Mahal Sunrise Tour With Tour Guide From Delhi?","answer":"The tour lasts approximately 12–14 hours, including round-trip travel between Delhi and Agra and guided visits to the Taj Mahal and Agra Fort."},{"question":"What time does the tour start?","answer":"The scheduled pickup is between 2 am and 3 am from your given location in Delhi. A preferred pickup time can be arranged, taking the journey time and sunrise visit into account."},{"question":"Where will I meet my tour guide?","answer":"You will meet your professional tour guide upon arrival in Agra before visiting the Taj Mahal."},{"question":"Which monuments are included in the itinerary?","answer":"The itinerary includes a sunrise visit to the Taj Mahal followed by a guided visit to Agra Fort."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Is pickup and drop-off included?","answer":"Yes. Airport or hotel pickup and drop-off are included. Your chauffeur will return you to your hotel, the airport, or your given location in Delhi."},{"question":"Is there a breakfast stop?","answer":"You can stop for breakfast after visiting the Taj Mahal and before exploring Agra Fort. Breakfast is not listed among the tour inclusions."},{"question":"Are monument entrance fees included?","answer":"Monument entrance fees and camera fees are excluded."}],"mapEmbedUrl":"https://www.google.com/maps?q=Taj+Mahal+Agra+India&output=embed","seo":{"title":"Taj Mahal Sunrise Tour With Tour Guide From Delhi","description":"Experience the Taj Mahal at sunrise and explore Agra Fort on a private 12–14 hour tour from Delhi with a professional guide, AC car, and return transfers."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"2 Days Taj Mahal Sunrise and Sunset Tour","slug":"2-days-taj-mahal-sunrise-and-sunset-tour","summary":"Experience the Taj Mahal at sunrise and sunset on a private two-day tour from Delhi, including Agra Fort, Baby Taj, Fatehpur Sikri, and an overnight stay in Agra.","description":"Discover Agra's highlights on this private 2 Days Taj Mahal Sunrise and Sunset Tour with a professional tour guide. Enjoy sunset views of the Taj Mahal from Mehtab Bagh and explore the iconic monument at sunrise the following morning.\n\nVisit Agra Fort, the Tomb of Itmad-ud-Daulah, also known as Baby Taj, and the historic city of Fatehpur Sikri. Learn about Mughal history and admire the architecture of these remarkable sites.\n\nTravel in a private air-conditioned car with a professional chauffeur and stay overnight in your choice of a 3-star, 4-star, or 5-star hotel. Guide services are available in English, Spanish, German, Italian, and French.","location":"Delhi – Agra – Delhi","duration":"2 days","groupSize":"Private tour","image":null,"imageAlt":"The Taj Mahal viewed across the Yamuna River from Mehtab Bagh at sunset","gallery":[],"highlights":["Explore Agra's UNESCO World Heritage Sites.","Discover Mughal history with insights from a private professional tour guide.","Travel to and from Delhi in a private air-conditioned car.","Enjoy arranged transfers for your sunrise visit to the Taj Mahal.","Admire the imposing red sandstone architecture of Agra Fort.","See the Taj Mahal at sunrise and enjoy sunset views from Mehtab Bagh.","Visit the Tomb of Itmad-ud-Daulah, also known as Baby Taj.","Explore the historic Mughal city of Fatehpur Sikri."],"itinerary":[{"label":"Day 1","title":"Pickup in Delhi, Drive to Agra and Hotel Check-in","description":"Your chauffeur will meet you at 9 am or your preferred time at your given location in Delhi. Relax during the approximately 3–4 hour drive to Agra in a comfortable private air-conditioned car.\n\nUpon arrival, check in to your hotel and meet your professional tour guide in the hotel lobby."},{"label":"Day 1","title":"Agra Fort","description":"Explore Agra Fort with your tour guide and learn about its association with Mughal Emperor Akbar.\n\nAdmire its imposing red sandstone buildings and the Hindu and Islamic architectural influences reflected throughout the complex."},{"label":"Day 1","title":"Itmad-ud-Daulah — Baby Taj","description":"Visit the Tomb of Itmad-ud-Daulah, popularly known as Baby Taj. Explore this elegant mausoleum with your guide and discover the architectural details that invite comparisons with the Taj Mahal."},{"label":"Day 1","title":"Sunset at Mehtab Bagh and Overnight Stay","description":"In the evening, visit Mehtab Bagh for sunset views of the Taj Mahal across the Yamuna River.\n\nAfter your visit, return to your hotel for an overnight stay in Agra."},{"label":"Day 2","title":"Taj Mahal Sunrise Visit","description":"Your chauffeur and tour guide will collect you from your hotel at the scheduled time of 6 am for your Taj Mahal visit. Allow approximately 2–3 hours to explore the monument.\n\nEnjoy its early-morning views and admire the white marble mausoleum from the outside and inside while your guide shares its history. The pickup time should be coordinated with the seasonal sunrise."},{"label":"Day 2","title":"Breakfast and Hotel Check-out","description":"Return to your hotel after visiting the Taj Mahal for a breakfast break. Check out before continuing to Fatehpur Sikri."},{"label":"Day 2","title":"Fatehpur Sikri","description":"Enjoy an excursion to Fatehpur Sikri, the historic red sandstone city built by Mughal Emperor Akbar and once used as his capital.\n\nExplore its preserved buildings with your tour guide and learn about the city often called the Ghost City."},{"label":"Day 2","title":"Return to Delhi and Drop-off","description":"After exploring Fatehpur Sikri, travel back to Delhi in your private air-conditioned car. Your chauffeur will drop you at your hotel, the airport, or your given location."}],"inclusions":["Transportation by private air-conditioned car","Experienced licensed driver","Services of a professional tour guide","Airport or hotel pickup and drop-off","Packaged drinking water bottles in the car","One overnight stay in Agra at a 3-star, 4-star, or 5-star hotel, according to your selected option","Car parking and airport parking","Toll taxes, fuel, and driver allowance"],"exclusions":["Lunch and dinner","Any optional trip","Monument entrance fees and camera fees","Anything not specified under the inclusions"],"faqs":[{"question":"How long is the Taj Mahal Sunrise and Sunset Tour?","answer":"The tour lasts two days and includes an overnight stay in Agra, with pickup and return transfers in Delhi."},{"question":"Where will I see the Taj Mahal at sunset?","answer":"You will visit Mehtab Bagh on the first evening for sunset views of the Taj Mahal across the Yamuna River. The visit inside the Taj Mahal takes place the following morning."},{"question":"Which sites are included in the itinerary?","answer":"The itinerary includes Agra Fort, the Tomb of Itmad-ud-Daulah, Mehtab Bagh, the Taj Mahal, and Fatehpur Sikri."},{"question":"Is hotel accommodation included?","answer":"Yes. The tour includes an overnight stay in Agra at a 3-star, 4-star, or 5-star hotel, according to your selected option."},{"question":"Where and when does the tour start?","answer":"Your chauffeur will collect you from your given location in Delhi at 9 am or your preferred time on the first day."},{"question":"Which languages are available for the guided tour?","answer":"Tour guide services are available in English, Spanish, German, Italian, and French."},{"question":"Are meals included?","answer":"Lunch and dinner are excluded. The itinerary includes a hotel breakfast break on the second day, but breakfast inclusion should be confirmed with your selected hotel option."},{"question":"Are monument entrance fees included?","answer":"Monument entrance fees and camera fees are excluded."},{"question":"Where does the tour end?","answer":"Your chauffeur will drive you back to Delhi on the second day and drop you at your hotel, the airport, or your given location."}],"mapEmbedUrl":"https://www.google.com/maps?q=Agra+India&output=embed","seo":{"title":"2 Days Taj Mahal Sunrise and Sunset Tour From Delhi","description":"Enjoy Taj Mahal sunrise and sunset views on a private 2-day Delhi tour with Agra Fort, Baby Taj, Fatehpur Sikri, a guide, AC car, and hotel stay."},"draft":false,"breadcrumbImage":"assets/img/inner-page/breadcrumb/bg-4.jpg"},{"name":"Taj Mahal Overnight Tour with Guide","slug":"taj-mahal-overnight-tour-with-guide","summary":"Discover Agra on a private two-day tour from Delhi with Taj Mahal sunrise and sunset views, guided sightseeing, and an overnight hotel stay.","description":"Explore Agra's highlights on this private Taj Mahal Overnight Tour with Guide from Delhi. Enjoy sunset views of the Taj Mahal from Mehtab Bagh and visit the iconic white marble mausoleum at sunrise the following morning.\n\nDiscover the history and architecture of Agra Fort, the Tomb of Itmad-ud-Daulah, also known as Baby Taj, and Fatehpur Sikri with your professional tour guide.\n\nTravel comfortably in a private air-conditioned car with an experienced chauffeur and stay overnight in your choice of a 3-star, 4-star, or 5-star hotel. Guide services are available in English, Spanish, German, Italian, and French.","location":"Delhi – Agra – Delhi","duration":"2 days","groupSize":"Private tour","image":null,"imageAlt":"The Taj Mahal viewed from Mehtab Bagh across the Yamuna River at sunset","gallery":[],"highlights":["Explore Agra's UNESCO World Heritage Sites.","Learn about the monuments with insights from a private professional tour guide.","Travel to and from Delhi in a private air-conditioned car.","Admire the imposing red sandstone architecture of Agra Fort.","Enjoy arrang