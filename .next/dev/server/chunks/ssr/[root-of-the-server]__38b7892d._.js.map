[{"name":"Delhi Tour Guide","city":"delhi","description":"Discover Delhi’s historic neighbourhoods, monuments and markets with a local guide.","image":"assets/img/home-1/tour/tour-1.jpg","imageAlt":"","showOnMainGrid":true,"services":[{"name":"Old Delhi Walking Tour","slug":"old-delhi-walking-tour","summary":"Explore the lanes, bazaars, and food streets of Old Delhi with a local guide.","description":"Discover Old Delhi on a three-hour guided walk through Chandni Chowk. Explore the lanes around Jama Masjid, pass the food shops of Paranthe Wali Gali, and finish near Khari Baoli spice market. Along the way, your guide will share stories about the neighbourhood’s architecture, food traditions, and everyday life.","location":"Chandni Chowk, Old Delhi","duration":"3 hours","groupSize":"Up to 6 guests","image":"assets/img/tours/old-delhi/chandni-chowk.webp","imageAlt":"Shops and pedestrians in Chandni Chowk, Old Delhi","gallery":[{"src":"assets/img/tours/old-delhi/jama-masjid.webp","alt":"Red sandstone facade of Jama Masjid in Delhi"},{"src":"assets/img/tours/old-delhi/chandni-chowk.webp","alt":"Market street in Chandni Chowk"},{"src":"assets/img/tours/old-delhi/heritage-lane.webp","alt":"Historic lane in Old Delhi"},{"src":"assets/img/tours/old-delhi/khari-baoli.webp","alt":"Spice stalls in Khari Baoli market"},{"src":"assets/img/tours/old-delhi/paranthe-wali-gali.webp","alt":"Food shops along Paranthe Wali Gali"},{"src":"assets/img/tours/old-delhi/market-shops.webp","alt":"Traditional shops in an Old Delhi bazaar"}],"highlights":["Hear stories about Jama Masjid and the surrounding neighbourhood","Walk through the bazaars of Chandni Chowk","Discover the food shops of Paranthe Wali Gali","Explore the spice stalls of Khari Baoli"],"itinerary":[{"label":"Stop 1","title":"Jama Masjid","description":"Meet your guide near Jama Masjid and get an introduction to Old Delhi and its Mughal history."},{"label":"Stop 2","title":"Chandni Chowk","description":"Walk through the main baz