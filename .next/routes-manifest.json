{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/tour-areas/[city]",
      "regex": "^/tour\\-areas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity"
      },
      "namedRegex": "^/tour\\-areas/(?<nxtPcity>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tour-areas/[city]/[slug]",
      "regex": "^/tour\\-areas/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcity": "nxtPcity",
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/tour\\-areas/(?<nxtPcity>[^/]+?)/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
